#!/bin/bash
# git credential helper: provides GH_TOKEN for github.com by decrypting it
# on the fly from the SOPS-encrypted vault file.
#
# Contract (https://git-scm.com/docs/gitcredentials):
#   git <helper> get   → helper prints username=... / password=... for the
#                        request read from stdin (protocol=, host=, ...)
#   git <helper> store / erase → no-op (read-only helper)
#
# The token never lands on disk in plaintext: it is decrypted per request.
# Install:  git config --global credential.helper "/data/shitcluster/scripts/git-sops-credential"

# Repo root is the parent of the script dir (<repo>/scripts/...)
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
REPO_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
SOPS_FILE="${SOPS_FILE:-$REPO_ROOT/secrets/vault_data.sops.yaml}"

action="$1"
if [ "$action" = "get" ]; then
    host=$(sed -n 's/^host=//p' 2>/dev/null)
    if [ "$host" = "github.com" ]; then
        token=$(sops -d "$SOPS_FILE" 2>/dev/null | python3 -c \
            "import yaml,sys; print(yaml.safe_load(sys.stdin)['vault_data']['metacoma']['github'])")
        if [ -n "$token" ]; then
            printf 'username=metacoma\npassword=%s\n' "$token"
        fi
    fi
fi
exit 0
