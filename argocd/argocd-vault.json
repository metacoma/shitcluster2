{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "Application",
  "metadata": {
    "name": "argocd-vault",
    "namespace": "argocd"
  },
  "spec": {
    "syncPolicy": {
      "automated": {
      	"selfHeal": true
      }
    },
    "destination": {
      "namespace": "default",
      "server": "https://kubernetes.default.svc"
    },
    "project": "default",
    "source": {
      "path": "gitops/argocd-vault",
      "plugin": {
        "name": "kcl-v1.0"
      },
      "repoURL": "https://github.com/metacoma/shitcluster2",
      "targetRevision": "master"
    }
  }
}
